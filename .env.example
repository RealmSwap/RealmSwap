# ---------------------------------------------------------------------------
# LOCAL app database (SQLite) — unchanged. Each install has its own file DB.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Servers allowed on the FREE tier (entitlement gate). Defaults high (999) so the
# gate is dormant until paid plans exist; set to e.g. 1 for a strict freemium cap.
FREE_TIER_SLOTS="999"

# ---------------------------------------------------------------------------
# CLOUD shared services (Supabase). PLACEHOLDERS ONLY — never commit real keys.
# See docs/supabase-shared-services.md for how to obtain each value.
# ---------------------------------------------------------------------------

# Public — safe to ship inside the desktop app (anon key is RLS-gated).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side ONLY (Edge Functions / admin tooling). NEVER ship these in the app —
# service_role bypasses RLS, and the direct DB URLs grant full Postgres access.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_PROJECT_REF="YOUR_PROJECT_REF"
# Prisma cloud client (tooling only). Pooled URL for runtime, direct for migrate/pull.
SUPABASE_DB_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_DB_DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Discord OAuth (Supabase Auth external provider). From the Discord dev portal.
SUPABASE_AUTH_DISCORD_CLIENT_ID="YOUR_DISCORD_OAUTH_CLIENT_ID"
SUPABASE_AUTH_DISCORD_SECRET="YOUR_DISCORD_OAUTH_CLIENT_SECRET"

# ---------------------------------------------------------------------------
# Stripe (subscription billing). Set the secrets as Supabase function secrets;
# only the publishable key is safe in the client.
#
# Feature flag: the billing page and /api/billing/* are HIDDEN unless this is
# "true". Leave off until a real Stripe account is set up.
BILLING_ENABLED="false"
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="sk_test_YOUR_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SIGNING_SECRET"
# Plan price ids (from Stripe). Optional if you sync the catalogue via webhook.
STRIPE_PRICE_STARTER="price_YOUR_STARTER_PRICE_ID"
STRIPE_PRICE_PARTY="price_YOUR_PARTY_PRICE_ID"
STRIPE_PRICE_GUILD="price_YOUR_GUILD_PRICE_ID"

# ---------------------------------------------------------------------------
# Offsite backup storage (S3-compatible). Optional legacy fallback: settings
# saved in the app (Dashboard → Backups, ADMIN only) take precedence. These
# env vars are only used when no user has saved settings.
# ---------------------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Crash reporting (fully optional). Without these the Sentry integration is
# inert — no network calls, nothing initialised. Create a Sentry project and
# paste its DSNs to activate opt-in crash reports (users must also toggle
# "Anonymous Crash Reports" on in Settings).
# ---------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Secret the Discord bot uses to call /api/bot/action (start/stop/restart).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The bot API is DISABLED when this and DISCORD_BOT_TOKEN are both unset.
BOT_API_SECRET=""

# Steam Web API key — enables live Steam Workshop search for Project Zomboid
# mods (https://steamcommunity.com/dev/apishm). Without it the Mods tab falls
# back to a small curated catalogue; manual Workshop-ID installs still work.
# Mod installs/updates additionally use SteamCMD (auto-downloaded on Windows
# hosts) and do not need this key.
STEAM_API_KEY=""

# CurseForge (CFCore) API key — enables CurseForge as a Minecraft mod provider
# (search, installs, updates, and CurseForge modpack import). Get a free key at
# https://console.curseforge.com/. Two gotchas:
#  1. The key looks like a bcrypt hash ($2a$10$...). The $ characters MUST be
#     backslash-escaped (\$) or the env loader expands them and corrupts the
#     key. A valid key is exactly 60 characters after unescaping.
#  2. CurseForge gates games per key — new keys serve Minecraft (and a few
#     others) only; other games need Overwolf's extended-access approval.
CURSEFORGE_API_KEY=""
