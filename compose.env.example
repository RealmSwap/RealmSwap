# Copy to `.env` next to compose.yaml and fill in.
# The data volume the dashboard mounts at ./data (compose resolves it to an
# absolute path on the host) — game containers bind-mount server dirs from
# THIS path, so it must be absolute and must match where compose puts ./data.
REALMSWAP_HOST_DATA_DIR=/opt/realmswap/data

# Supabase shared services (auth + marketplace) — required. Same values the
# desktop app ships with. See docs/supabase-shared-services.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional.
FREE_TIER_SLOTS=999
BOT_API_SECRET=
STEAM_API_KEY=
CURSEFORGE_API_KEY=
SENTRY_DSN=
