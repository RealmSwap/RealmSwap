# RealmSwap marketing site — environment variables (PLACEHOLDERS ONLY).
#
# Copy to `.env.local` for local dev and fill in real values there.
# `.env.local` is gitignored — NEVER commit real secrets. On Vercel, set these
# in Project Settings → Environment Variables (Production / Preview / Development).
#
# These are the vars the server surface (route handlers / server actions) will
# need once it talks to the SHARED SUPABASE BACKEND. That backend is owned by a
# separate effort (agent `realmswap-supabase`, branch `feat/supabase-shared-services`).
# Until it lands, everything here is unused and the server surface is a no-op.

# --- Public (exposed to the browser; safe to ship) ---
# Supabase project URL and anonymous key for client-side reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (NEVER exposed to the browser) ---
# Used exclusively by route handlers / server actions running on Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional site config ---
# Canonical public URL of the deployed site (used for absolute links / metadata).
# e.g. https://realmswap.app  (leave blank to fall back to the Vercel-provided URL)
NEXT_PUBLIC_SITE_URL=
