// Prisma Schema for GameVault
//
// To switch this to PostgreSQL for production:
// 1. Change the provider below to "postgresql"
// 2. Change the url to env("DATABASE_URL")
// 3. Update your local .env file with your PostgreSQL connection string

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/client"
  engineType = "binary"
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String             // legacy — identity is now Supabase Auth; mirror rows store "" (unused)
  name               String
  discordId          String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  role               String             @default("USER") // "USER" | "ADMIN"
  notifyDiscord      Boolean            @default(true)
  notifyEmail        Boolean            @default(true)
  notifyWebPush      Boolean            @default(true)
  definitions        GameDefinition[]
  subscription       Subscription?
  servers            Server[]
  archives           Archive[]
  logs               ActivityLog[]
  collaboratorAccess Collaborator[]
  templateVotes      TemplateVote[]
  PushSubscription   PushSubscription[]
  players            Player[]
  s3Setting          S3Setting?
}

model DiscordLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  discordId String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String // "STARTER", "PARTY", "GUILD"
  status      String // "ACTIVE", "CANCELED"
  activeSlots Int // 1, 2, or 4 based on plan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Server {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  game             String // "MINECRAFT", "VALHEIM", "ZOMBOID", "ARK"
  ramAllocation    Float // GB allocated
  region           String // "US_EAST", "US_WEST", "EU_CENTRAL", "ASIA"
  status           String // "RUNNING", "STOPPED", "STARTING"
  runnerType       String              @default("CLOUD") // "LOCAL" | "DOCKER" | "AGENT"; default is a legacy value — resolveRunnerType always sets this explicitly at create, and the factory falls through to LOCAL for anything not "DOCKER" or "AGENT"
  nodeId           String? // Set when runnerType is "AGENT": the AgentNode hosting this server
  localPath        String? // File path for local server storage
  pid              Int? // Process ID for local runner execution
  password         String? // Unhashed password for Valheim/game server configs
  rconPort         Int?    // RCON Port
  rconPassword     String? // RCON Password
  sftpPassword     String? // Unique generated password for SFTP access
  sftpPort         Int?    // Assigned SFTP port (typically 2022+id)
  tunnelEnabled    Boolean             @default(false)
  tunnelUrl        String? // playit.gg tunnel URL (e.g., xxx.auto.playit.gg:12345)
  tunnelClaimUrl   String? // playit agent claim link while the agent is unclaimed
  tunnelPid        Int? // OS pid of the spawned playit agent, for orphan cleanup on boot
  enableUpnp       Boolean             @default(false) // Trigger router port mapping
  autoUpdate       Boolean             @default(false) // Nightly SteamCMD update while the server is stopped
  autoUpdateHour   Int                 @default(4) // Local hour (0-23) of the nightly update window
  lastAutoUpdateAt DateTime? // Last overnight update run (dedupes within a calendar day)
  ipAddress        String
  port             Int
  definitionId     String?
  definition       GameDefinition?     @relation(fields: [definitionId], references: [id])
  paramValues      String? // JSON object of custom param values
  pendingRestart   Boolean             @default(false) // Settings changed while running; cleared on next start
  healthStatus     String              @default("OK") // "OK", "DEGRADED", "FAILING"
  cpuUsage         Float               @default(0) // Mocked live utilization percentage
  memoryUsage      Float               @default(0) // Mocked live RAM utilization in GB
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  snapshotInterval Int                 @default(0) // 0 = disabled, 1, 6, 12, 24 hours
  lastSnapshotAt   DateTime?
  backupRetention  Int                 @default(20) // keep last N snapshot zips per server; 0 = keep everything
  backups          Backup[]
  collaborators    Collaborator[]
  mods             ModInstallation[]
  snapshots        ServerSnapshot[]
  modpack          InstalledModpack?
  automations      Automation[]
  hostLink         ServerHostLink?
  inviteCode       String?             @unique // For RealmSync
  statusShareCode  String?             @unique // Public no-login status page (/s/<code>); null = disabled
  autoStartLeadMinutes Int             @default(15) // Minutes before a planned Discord session to auto-boot (0 = at start time)
  idleStopEnabled  Boolean             @default(false) // Auto-stop once the server has been empty for idleStopMinutes
  idleStopMinutes  Int                 @default(30) // Empty streak (5-min player samples) that triggers the idle stop
  sessionAutoStopHours Int             @default(0) // Hours after a planned session's start to stop it if still empty; 0 = off
  firstOnlineAt    DateTime? // First time this server reached RUNNING — drives the first-boot celebration
  plannedSessions  PlannedSession[]
  discordRoles     DiscordRoleAccess[]
  playerAccess     PlayerServerAccess[]
  telemetry        ServerTelemetry[]
}

model DiscordRoleAccess {
  id        String   @id @default(cuid())
  serverId  String
  roleId    String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([serverId, roleId])
}

model PlannedSession {
  id        String   @id @default(cuid())
  serverId  String
  title     String
  startTime DateTime
  channelId String // The Discord channel where the event was posted
  messageId String // The Discord message ID of the embed
  roster    String // JSON array of Discord User IDs who clicked "I'm In"
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model ServerHostLink {
  id             String    @id @default(cuid())
  serverId       String    @unique
  server         Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  provider       String    @default("AKLIZ")
  host           String
  port           Int       @default(22)
  username       String
  secret         String
  remoteBasePath String    @default(".")
  includePaths   String? // JSON array of POSIX relPaths; null/[] = full mirror
  lastPushAt     DateTime?
  lastPullAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Archive {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverName String
  game       String // "MINECRAFT", "VALHEIM", "ZOMBOID", "ARK"
  saveSizeGB Float // Saved world storage size in GB
  archivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId  String? // server-scoped events (SERVER_CRASH); null for account-level actions
  action    String // "CREATE_SERVER", "START_SERVER", "STOP_SERVER", "SERVER_CRASH", "RESTART_SERVER", "ARCHIVE_SERVER", "RESTORE_SERVER", "DELETE_ARCHIVE"
  details   String
  metadata  String? // JSON extras for machine reading (exit codes, signals, retry counts)
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
}

model Backup {
  id         String   @id @default(cuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId     String
  name       String // e.g. "Survival World - Auto Save" or "Manual Snapshot"
  game       String // "MINECRAFT", etc.
  filePath   String // path to backup zip/folder on disk
  fileSizeMB Float
  backupType String // "MANUAL" or "AUTOMATED"
  verifiedAt DateTime? // last successful restore-verification (archive opened + entries decompressed)
  verifyError String? // non-null when the last verification failed
  offsiteStatus String? // null = never attempted; "PENDING", "UPLOADED", "FAILED"
  offsiteError String? // last offsite upload error message
  offsiteUploadedAt DateTime?
  createdAt  DateTime @default(now())
}

// Per-user offsite storage credentials. secretKey (and accessKey) are
// encrypted at rest by the same Prisma-boundary extension as Server secrets.
model S3Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String? // custom S3 endpoint (Cloudflare R2, DigitalOcean Spaces...); null = AWS
  region    String   @default("us-east-1")
  bucket    String
  accessKey String
  secretKey String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collaborator {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "ADMIN" or "CO_HOST"
  createdAt DateTime @default(now())

  @@unique([serverId, userId])
}

model GameDefinition {
  id               String   @id @default(cuid())
  slug             String
  displayName      String
  icon             String   @default("🎮")
  color            String   @default("from-slate-500 to-slate-700 bg-slate-500/10 border-slate-500/30 text-slate-400")
  description      String   @default("")
  recommendedRamGB Float    @default(4)
  requiredDiskGB   Float    @default(3)
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isBuiltIn        Boolean  @default(false)
  installMethod    String // "STEAMCMD" | "DOWNLOAD" | "CUSTOM_SCRIPT"
  spec             String // JSON GameDefinitionSpec
  servers          Server[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([ownerId, slug])
}

/// The modpack a Minecraft server currently runs (one pack per server).
/// Recorded by install-pack (which knows the CurseForge project/file ids) and
/// manual imports (identity only); the update-pack route re-resolves the
/// newest pack file and drops mods that left the new manifest.
model InstalledModpack {
  id            String   @id @default(cuid())
  serverId      String   @unique
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind          String // "curseforge" | "mrpack"
  projectId     String? // CurseForge project id — update resolution needs it
  fileId        Int? // CurseForge file id currently installed
  fileName      String?
  packName      String
  version       String // the pack's own version string
  mcVersion     String?
  loaderType    String?
  loaderVersion String?
  /// JSON array of ModInstallation packageIds this pack installed — the
  /// exact set an update may retire when the new manifest drops them.
  packageIds    String?
  installedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ModInstallation {
  id           String   @id @default(cuid())
  serverId     String
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  provider     String // "thunderstore", "workshop", "manual"
  packageId    String // "denikson-BepInExPack_Valheim"
  version      String
  name         String
  dependencies String? // JSON array of required packageIds
  workshopModId String? // Zomboid: the mod ID written to Mods= in servertest.ini (packageId is the Workshop ID)
  installedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([serverId, provider, packageId])
}

model ServerSnapshot {
  id          String   @id @default(cuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId      String
  name        String // "Pre-EpicLoot Update"
  path        String // Path to the cloned server state directory
  gameVersion String?
  modCount    Int
  createdAt   DateTime @default(now())
}

model ServerTelemetry {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpu       Float    // CPU percentage
  ramMB     Float    // RAM used in MB
  diskMB    Float? // Server folder size in MB (null on rows written before this existed)
  playerCount Int?   // Players reported by the game query, stamped every ~5 min (null = no sample this tick / query failed)
  maxPlayers  Int?   // Slot count reported alongside playerCount (null when the game doesn't report it)
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
}

model Automation {
  id            String    @id @default(cuid())
  serverId      String
  server        Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name          String
  enabled       Boolean   @default(true)
  triggerType   String    // "CRON", "ONE_TIME", "DAILY", "WEEKLY", "MONTHLY", "SERVER_CRASH", etc.
  triggerConfig String?   // JSON
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastRunAt     DateTime?
  nextRunAt     DateTime?

  conditions    AutomationCondition[]
  actions       AutomationAction[]
  executions    AutomationExecution[]
}

model AutomationCondition {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type         String     // "PLAYERS_ONLINE", "CPU_USAGE", "RAM_USAGE", "SERVER_STATE"
  operator     String     // "EQUALS", "LESS_THAN", "GREATER_THAN"
  value        String
}

model AutomationAction {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  order        Int
  type         String     // "START_SERVER", "RESTART_SERVER", "DISCORD_ANNOUNCEMENT"
  config       String?    // JSON
}

model AutomationExecution {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  status       String     // "SUCCESS", "RUNNING", "FAILED"
  logs         String?    // JSON array of execution logs/details
}

model MarketplaceTemplate {
  id            String         @id @default(cuid())
  name          String
  description   String
  author        String
  gameSlug      String
  tags          String // Comma separated
  downloads     Int            @default(0)
  likes         Int            @default(0)
  dislikes      Int            @default(0)
  verifiedLevel String         @default("UNVERIFIED") // "UNVERIFIED", "VERIFIED", "OFFICIAL"
  votes         TemplateVote[]

  // The payload contains Mod lists, Config file overrides, and Params
  payload String // JSON TemplatePayload

  // If the template introduces an UNSUPPORTED game, the full definition goes here
  customDefSpec String? // JSON GameDefinitionSpec

  createdAt DateTime @default(now())
}

model TemplateVote {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  type       String // "LIKE" or "DISLIKE"
  createdAt  DateTime @default(now())

  template MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Player {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name               String
  steamId            String?
  xboxId             String?
  minecraftUuid      String?
  discordId          String?
  
  status             String             @default("TRUSTED") // "TRUSTED", "VIP", "BANNED", "GUEST"
  roles              String?            // Comma-separated global roles
  
  isGloballyBanned   Boolean            @default(false)
  globalBanReason    String?
  
  serverAccess       PlayerServerAccess[]
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model PlayerServerAccess {
  id                 String             @id @default(cuid())
  playerId           String
  serverId           String
  
  isWhitelisted      Boolean            @default(false)
  isBanned           Boolean            @default(false)
  serverRole         String?            // Override or specific role for this server
  
  player             Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  server             Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  
  @@unique([playerId, serverId])
}

model PlayerAuditLog {
  id                 String             @id @default(cuid())
  playerId           String?            // Null if the action was general, but usually targeted at a player
  serverId           String?            // Null if action was global
  action             String             // "GLOBAL_BAN", "WHITELIST_ADD", "ROLE_ASSIGNED"
  details            String
  performedBy        String             // User ID of the admin who performed it
  createdAt          DateTime           @default(now())
}

model AgentNode {
  id               String    @id @default(cuid())
  name             String
  userId           String    // Admin who created the enrollment
  status           String    @default("PENDING") // "PENDING" (awaiting agent enrollment) | "ACTIVE" | "REVOKED"
  enrollTokenHash  String?   @unique // sha256 of the one-time enrollment token (never stored in plaintext)
  enrollExpiresAt  DateTime?
  enrollTokenEnc   String? // Token re-served to the minting ADMIN until the node enrolls or the token expires — encrypted at rest via AGENT_NODE_SECRET_FIELDS
  secret           String? // The node's HMAC secret — encrypted at rest via AGENT_NODE_SECRET_FIELDS; the agent holds the only other copy
  platform         String? // os.platform() of the agent host
  arch             String?
  agentVersion     String?
  dockerVersion    String?
  lanIp            String? // Agent-reported LAN address — what friends connect to
  totalRamMB       Int?
  freeDiskGB       Float?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model AgentCommand {
  id          String    @id @default(cuid())
  nodeId      String
  serverId    String
  type        String // "START" | "STOP" | "UPDATE" | "SEND_COMMAND"
  payload     String // JSON — fully-resolved launch plan (dashboard owns all game knowledge)
  status      String    @default("PENDING") // "PENDING" | "SENT" | "DONE" | "FAILED"
  result      String? // JSON — { ok, error?, exitCode? }
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  completedAt DateTime?

  @@index([nodeId, status])
  @@index([serverId])
}
